{
  "rules": {
    "contenuti": {
      ".read": true,

      "capi": {
        ".write": "auth != null",
        "$capo": {
          ".validate": "newData.hasChildren(['nome', 'ruolo', 'branca'])",
          "nome":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "ruolo":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "branca":   { ".validate": "newData.val().matches(/^(gruppo|branco|reparto|noviziato|clan)$/)" },
          "foto":     { ".validate": "newData.isString() && newData.val().length <= 500" },
          "titolare": { ".validate": "newData.isBoolean()" },
          "ordine":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$altro":   { ".validate": false }
        }
      },

      "iscrizioni": {
        ".write": "auth != null",
        "anno":         { ".validate": "newData.isString() && newData.val().length <= 30" },
        "aperte":       { ".validate": "newData.isBoolean()" },
        "linkModulo":   { ".validate": "newData.isString() && newData.val().length <= 300" },
        "dataRiunione": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "testo":        { ".validate": "newData.isString() && newData.val().length <= 1500" },
        "notaEsito":    { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "$altro":       { ".validate": false }
      },

      "avvisi": {
        ".write": "auth != null",
        "$avviso": {
          ".validate": "newData.hasChildren(['titolo', 'testo'])",
          "titolo": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "testo":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "attivo": { ".validate": "newData.isBoolean()" },
          "ordine": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "data":   { ".validate": "newData.isString() && newData.val().length <= 20" },
          "$altro": { ".validate": false }
        }
      },

      "$altro": { ".validate": false }
    },

    "$resto": {
      ".read": false,
      ".write": false
    }
  }
}
